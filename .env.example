# Database Configuration — same Postgres instance/credentials the Go API uses
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=

# Security — must match the Go API's JWT_SECRET (both services verify the same tokens)
JWT_SECRET=

# Points at the Go API — same value as the Go backend's own API_BASE_URL
API_BASE_URL=http://localhost:8082

# Shared Redis instance (same one the Go backend's docker-compose runs) —
# backs Flask-Limiter so rate limits are enforced correctly across Gunicorn
# workers instead of counted separately per worker. Use DB /1 to stay out of
# the Go backend's Asynq keyspace. Leave unset for local dev (falls back to
# in-memory limiting, fine for a single process).
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6379/1

# Optional — port this Flask admin panel listens on when run directly (python run.py)
ADMIN_PORT=5000
